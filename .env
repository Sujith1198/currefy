# Currefy Environment Configuration
# ─────────────────────────────────────────────────────────
# This SINGLE .env works for BOTH local (XAMPP) and production server.
# Just change CI_ENVIRONMENT and app.baseURL when deploying.
# ─────────────────────────────────────────────────────────

# ── ENVIRONMENT ──────────────────────────────────────────
# Set to 'development' for local, 'production' for server
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# LOCAL  : http://localhost/converter/currefy/public/
# SERVER : https://currefy.com/
app.baseURL = 'http://localhost/converter/currefy/public/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

# Google Analytics (only loads when this value is set)
# app.googleAnalyticsId = 'G-RDE31FQ6TE'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'currefy_session'
session.expiration = 7200
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie'
security.expires = 7200
security.regenerate = false
security.redirect = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = currefy
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ADMIN ANALYTICS LOGIN
#--------------------------------------------------------------------
# Set these before using /admin/login.
# Generate hash: php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
# admin.email = admin@example.com
# admin.passwordHash = '$2y$10$replace-with-generated-hash'

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# encryption.key = your-random-32-char-key-here
