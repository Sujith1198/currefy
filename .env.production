# Currefy.com — Production Environment
# ─────────────────────────────────────────────────────────
# Copy this file to ".env" on the server before deploying.
# Only the values that DIFFER from the defaults are listed.
# ─────────────────────────────────────────────────────────

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://currefy.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.googleAnalyticsId = 'G-RDE31FQ6TE'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'currefy_session'
session.expiration = 7200
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie'
security.expires = 7200
security.regenerate = false
security.redirect = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = currefy
database.default.username = currefy_user
database.default.password = 'CHANGE_THIS_DATABASE_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ADMIN ANALYTICS LOGIN
#--------------------------------------------------------------------
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
admin.email = admin@currefy.com
admin.passwordHash = 'REPLACE_WITH_GENERATED_PASSWORD_HASH'

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# encryption.key = your-random-32-char-key-here
