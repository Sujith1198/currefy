# Currefy.com — Root .htaccess for hosts where document root = project root
# (Routes all requests into public/ and blocks direct access to app internals)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Route everything through public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ---- Block direct access to app internals ----
<FilesMatch "^(\.env|\.env\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
